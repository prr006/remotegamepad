<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RemoteGamepadServer.Tests</RootNamespace>
    <AssemblyName>RemoteGamepadServer.Tests</AssemblyName>
    <!-- Deliberately dependency-free: the tests run with plain "dotnet run", so no
         extra NuGet packages have to be restored on a freshly set up Linux box. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RemoteGamepadServer/RemoteGamepadServer.csproj" />
  </ItemGroup>
</Project>
