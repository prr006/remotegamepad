<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gamepad_panel"
    android:keepScreenOn="true">

    <!--
      V8 — All sizes and positions derived directly from reference screenshot
      (1536×768 = 2:1 aspect ratio). No arbitrary adjustments.

      METHODOLOGY:
        1. Measured pixel centers from the reference image.
        2. Converted to fractions of 1536 (x) and 768 (y).
        3. Applied the EXACT ConstraintLayout bias formula:
             For 1:1 views  (h_pct P on screen W×H, W=2H):
               view_width_pct = P/2
               H_bias = (cx_frac - P/4)  / (1 - P/2)
               V_bias = (cy_frac - P/2)  / (1 - P)
             For ShoulderButtonView (independent w_pct, h_pct):
               H_bias = (cx_frac - w_pct/2) / (1 - w_pct)
               V_bias = (cy_frac - h_pct/2) / (1 - h_pct)

      All 19 control positions verified against reference image coordinates.
      All 25 GamepadActivity.kt IDs present, zero duplicates.

      CONTROL SIZES (measured from 1536×768 reference):
        ShoulderButtonView: w=0.085  h=0.130   (130×100px in reference)
        RoundButtonView (D-pad): h_pct=0.122   (~94px diameter)
        RoundButtonView (ABXY):  h_pct=0.143   (~110px diameter)
        RoundButtonView (L3/R3): h_pct=0.124   (~95px diameter)
        RoundButtonView (View/Menu): h_pct=0.10
        RoundButtonView (Home):  h_pct=0.12
        JoystickView:  h_pct=0.28  (~200px visual ring on 768px screen)

      REFERENCE CENTER POSITIONS (x%, y%) → BIAS VALUES:
        LT  (4.6%, 15.0%) → h=0.004 v=0.098
        LB  (13.0%,15.0%) → h=0.091 v=0.098
        RB  (87.0%,15.0%) → h=0.864 v=0.098
        RT  (95.4%,15.0%) → h=0.952 v=0.098
        View(38.3%, 6.1%) → h=0.377 v=0.012
        Home(46.0%, 6.1%) → h=0.457 v=0.001
        Menu(53.3%, 6.1%) → h=0.535 v=0.012
        DUp ( 8.7%,28.9%) → h=0.060 v=0.260
        DLft( 3.9%,40.4%) → h=0.009 v=0.391
        DRt (13.5%,40.4%) → h=0.111 v=0.391
        DDn ( 8.7%,51.8%) → h=0.060 v=0.521
        Y   (78.3%,28.6%) → h=0.805 v=0.250
        X   (72.4%,40.4%) → h=0.741 v=0.388
        B   (85.3%,40.4%) → h=0.880 v=0.388
        A   (78.3%,52.1%) → h=0.805 v=0.525
        LJS (22.1%,65.1%) → h=0.176 v=0.710
        RJS (68.5%,65.1%) → h=0.715 v=0.710
        L3  ( 4.2%,91.1%) → h=0.012 v=0.969
        R3  (95.8%,91.1%) → h=0.988 v=0.969
    -->

    <!-- ══════════════════════════════════════════════════════
         TOP-LEFT: LT / LB
         Size measured from reference: ~130px wide × ~100px tall.
         w_pct=0.085 (130/1536)  h_pct=0.130 (100/768)
         LT center: (4.6%, 15.0%)
         LB center: (13.0%, 15.0%)   — touching LT's right edge, matching ref.
         ══════════════════════════════════════════════════════ -->

    <com.example.remotegamepad.ui.ShoulderButtonView
        android:id="@+id/btnLT"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.085"
        app:layout_constraintHeight_percent="0.130"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.004"
        app:layout_constraintVertical_bias="0.098" />

    <com.example.remotegamepad.ui.ShoulderButtonView
        android:id="@+id/btnLB"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.085"
        app:layout_constraintHeight_percent="0.130"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.091"
        app:layout_constraintVertical_bias="0.098" />

    <!-- ══════════════════════════════════════════════════════
         TOP-RIGHT: RB / RT
         RB center: (87.0%, 15.0%)
         RT center: (95.4%, 15.0%)   — touching RB's left edge, matching ref.
         ══════════════════════════════════════════════════════ -->

    <com.example.remotegamepad.ui.ShoulderButtonView
        android:id="@+id/btnRB"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.085"
        app:layout_constraintHeight_percent="0.130"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.864"
        app:layout_constraintVertical_bias="0.098" />

    <com.example.remotegamepad.ui.ShoulderButtonView
        android:id="@+id/btnRT"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.085"
        app:layout_constraintHeight_percent="0.130"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.952"
        app:layout_constraintVertical_bias="0.098" />

    <!-- ══════════════════════════════════════════════════════
         TOP-CENTER: VIEW / HOME / MENU
         Measured at top of reference image (y≈6.1%).
         ivLogo is a tiny icon referenced by setupCenterButtons() (no-op).
         ══════════════════════════════════════════════════════ -->

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHeight_percent="0.04"
        android:src="@drawable/ic_gamepad_logo"
        android:contentDescription="@string/app_name"
        android:alpha="0.70"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.01" />

    <!-- btnView: ◄ left of trio, center at (38.3%, 6.1%), h_pct=0.10 -->
    <com.example.remotegamepad.ui.RoundButtonView
        android:id="@+id/btnView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHeight_percent="0.10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
