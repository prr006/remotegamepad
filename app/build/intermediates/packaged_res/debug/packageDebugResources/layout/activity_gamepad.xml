        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:alpha="0.5"
        app:layout_constraintEnd_toStartOf="@id/btnChangeConnection"
        app:layout_constraintBottom_toBottomOf="@id/btnChangeConnection"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvLayoutToggleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_layout_xbox"
            android:textColor="@color/rg_text_secondary"
            android:textSize="9sp"
            android:letterSpacing="0.08" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnChangeConnection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_connection_pill"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:alpha="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/gamepadConnDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_conn_signal"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvConnLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/status_connected"
            android:textColor="@color/rg_text_secondary"
            android:textSize="9sp"
            android:letterSpacing="0.08" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
